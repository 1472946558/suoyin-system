.brand-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.brand-name,
.brand-desc {
  display: block;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.brand-desc {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.brand-chip {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #8a5a00;
  font-size: 22rpx;
  font-weight: 900;
  background: var(--gold-soft);
}

.hero-metrics {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 32rpx;
}

.hero-metric {
  padding: 18rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.08);
}

.metric-value,
.metric-label {
  display: block;
}

.metric-value {
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
}

.metric-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 20rpx;
}

.hero-actions {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 12rpx;
  margin-top: 34rpx;
}

.hero-action {
  overflow: hidden;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  min-width: 0;
  height: 92rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  line-height: 1;
  white-space: nowrap;
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.12),
    0 14rpx 28rpx rgba(0, 0, 0, 0.16);
}

.hero-action::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.2), transparent 56%);
}

.hero-order {
  color: #fff;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.13), transparent 58%),
    rgba(16, 17, 20, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.34);
}

.hero-service {
  color: #fff;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.18), transparent 58%),
    rgba(255, 206, 53, 0.2);
  border: 1rpx solid rgba(255, 206, 53, 0.72);
}

.hero-action-icon-wrap {
  position: relative;
  z-index: 1;
  display: grid;
  place-items: center;
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.16);
}

.hero-action-icon {
  position: relative;
  z-index: 1;
  width: 34rpx;
  height: 34rpx;
}

.hero-action-copy {
  position: relative;
  z-index: 1;
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.hero-action-title,
.hero-action-desc {
  position: relative;
  z-index: 1;
  display: block;
  min-width: 0;
  text-align: left;
}

.hero-action-title {
  font-size: 24rpx;
  font-weight: 900;
}

.hero-action-desc {
  color: rgba(255, 255, 255, 0.58);
  font-size: 18rpx;
}

.hero-btn {
  width: 100%;
}

.quick {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.quick-icon-wrap {
  display: grid;
  place-items: center;
  width: 86rpx;
  height: 86rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f6f7fb 100%);
  box-shadow: inset 0 0 0 1rpx var(--line);
}

.quick-icon {
  width: 58rpx;
  height: 58rpx;
}

.quick-name {
  font-size: 24rpx;
  font-weight: 900;
}

.quick-desc {
  color: var(--muted);
  font-size: 20rpx;
}

.small {
  font-size: 24rpx;
  font-weight: 500;
}

.address-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 92rpx;
  border-bottom: 1rpx solid var(--line);
}

.address-line:last-of-type {
  border-bottom: 0;
}

.address-line input {
  flex: 1;
  height: 88rpx;
  font-size: 29rpx;
}

.line-icon {
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 46rpx;
}

.estimate-result {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 26rpx 0;
}

.estimate-price {
  display: block;
  margin-top: 4rpx;
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
}

.estimate-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.flow-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  padding: 22rpx;
}

.flow-step {
  min-height: 118rpx;
  padding: 18rpx 12rpx;
  border-radius: 24rpx;
  background: #f7f8fb;
}

.flow-icon {
  width: 42rpx;
  height: 42rpx;
}

.flow-num,
.flow-name {
  display: block;
}

.flow-num {
  color: var(--brand-strong);
  font-size: 22rpx;
  font-weight: 900;
}

.flow-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
}

.promise-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.promise {
  position: relative;
  overflow: hidden;
  min-height: 154rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(16, 17, 20, 0.05);
}

.promise::after {
  content: "";
  position: absolute;
  right: -34rpx;
  top: -34rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: rgba(255, 206, 53, 0.16);
}

.promise-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.promise-icon {
  width: 48rpx;
  height: 48rpx;
}

.promise-code {
  display: block;
  color: var(--brand-strong);
  font-size: 22rpx;
  font-weight: 900;
}

.promise-title {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
}

.promise-desc {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.5;
}
