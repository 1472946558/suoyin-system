<view class="page home">
  <view class="brand-strip">
    <view>
      <text class="brand-name">疾蜂急送</text>
      <text class="brand-desc">企业级同城配送前端方案</text>
    </view>
    <text class="brand-chip">深圳试运营</text>
  </view>

  <view class="dark-hero">
    <text class="eyebrow">CITY EXPRESS</text>
    <text class="hero-title">一单一送，准时抵达</text>
    <text class="hero-subtitle">面向文件、鲜花、数码、生鲜的同城急送服务。下单前估价，配送中追踪，异常可联系客服。</text>
    <view class="hero-metrics">
      <view class="hero-metric" wx:for="{{metrics}}" wx:key="label">
        <text class="metric-value">{{item.value}}</text>
        <text class="metric-label">{{item.label}}</text>
      </view>
    </view>
    <view class="hero-actions">
      <button class="hero-action hero-order" bindtap="goOrder">
        <view class="hero-action-icon-wrap">
          <image class="hero-action-icon" src="/assets/ui/price.png" mode="aspectFit" />
        </view>
        <view class="hero-action-copy">
          <text class="hero-action-title">立即下单</text>
          <text class="hero-action-desc">智能估价</text>
        </view>
      </button>
      <button class="hero-action hero-service" bindtap="callService">
        <view class="hero-action-icon-wrap">
          <image class="hero-action-icon" src="/assets/ui/support.png" mode="aspectFit" />
        </view>
        <view class="hero-action-copy">
          <text class="hero-action-title">客服咨询</text>
          <text class="hero-action-desc">异常/售后</text>
        </view>
      </button>
    </view>
  </view>

  <view class="section-title">
    <view>
      <text>常用急送</text>
      <text class="section-kicker">选择物品类型后可直接进入下单</text>
    </view>
  </view>
  <view class="quick card subtle-card">
    <view class="quick-item" wx:for="{{scenes}}" wx:key="name" bindtap="chooseScene" data-name="{{item.name}}">
      <view class="quick-icon-wrap">
        <image class="quick-icon" src="{{item.icon}}" mode="aspectFit" />
      </view>
      <text class="quick-name">{{item.name}}</text>
      <text class="quick-desc">{{item.desc}}</text>
    </view>
  </view>

  <view class="section-title">
    <view>
      <text>价格预估</text>
      <text class="section-kicker">客户接入真实服务器后可替换为后端计价 API</text>
    </view>
    <text class="muted small">模拟估价</text>
  </view>
  <view class="card estimator">
    <view class="address-line">
      <image class="line-icon" src="/assets/ui/pickup.png" mode="aspectFit" />
      <input value="{{fromAddress}}" placeholder="从哪里取？" bindinput="onFromInput" />
    </view>
    <view class="address-line">
      <image class="line-icon" src="/assets/ui/dropoff.png" mode="aspectFit" />
      <input value="{{toAddress}}" placeholder="送到哪里？" bindinput="onToInput" />
    </view>
    <view class="estimate-result">
      <view>
        <text class="muted">预估费用</text>
        <text class="estimate-price">¥{{estimate.price}}</text>
      </view>
      <view class="estimate-meta">
        <text>{{estimate.distance}}</text>
        <text>预计 {{estimate.time}} 分钟</text>
      </view>
    </view>
    <button class="primary-btn" bindtap="goOrderWithAddress">按此地址下单</button>
  </view>

  <view class="section-title">
    <view>
      <text>下单流程</text>
      <text class="section-kicker">从用户下单到骑手履约的最小闭环</text>
    </view>
  </view>
  <view class="flow-card card">
    <view class="flow-step" wx:for="{{flow}}" wx:key="name">
      <image class="flow-icon" src="{{item.icon}}" mode="aspectFit" />
      <text class="flow-num">0{{index + 1}}</text>
      <text class="flow-name">{{item.name}}</text>
    </view>
  </view>

  <view class="section-title">
    <view>
      <text>服务保障</text>
      <text class="section-kicker">商用上线需要这些能力逐步接入真实系统</text>
    </view>
  </view>
  <view class="promise-grid">
    <view class="promise" wx:for="{{promises}}" wx:key="title">
      <view class="promise-head">
        <image class="promise-icon" src="{{item.icon}}" mode="aspectFit" />
        <text class="promise-code">{{item.code}}</text>
      </view>
      <text class="promise-title">{{item.title}}</text>
      <text class="promise-desc">{{item.desc}}</text>
    </view>
  </view>
</view>
