.track-card .hero-title {
  font-size: 52rpx;
}

.rider-card {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
}

.rider-name,
.rider-phone {
  display: block;
}

.rider-name {
  font-size: 30rpx;
  font-weight: 900;
}

.rider-phone {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
}

.call-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 900;
  background: var(--brand);
}

.call-btn image {
  width: 32rpx;
  height: 32rpx;
}

.timeline {
  padding-left: 34rpx;
}

.step {
  position: relative;
  display: flex;
  gap: 20rpx;
  padding-bottom: 34rpx;
}

.step::before {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 38rpx;
  bottom: 0;
  width: 2rpx;
  background: var(--line);
}

.step:last-child::before {
  display: none;
}

.step-dot {
  position: relative;
  z-index: 1;
  display: grid;
  place-items: center;
  width: 38rpx;
  height: 38rpx;
  border: 4rpx solid #d8dde6;
  border-radius: 50%;
  background: #fff;
}

.step-dot image {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.42;
}

.step.done .step-dot {
  border-color: var(--brand);
  background: var(--ink);
}

.step.done .step-dot image {
  opacity: 1;
}

.step-title {
  display: block;
  font-size: 29rpx;
  font-weight: 900;
}

.step-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.map-mock {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.map-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.map-title-row image {
  width: 44rpx;
  height: 44rpx;
}

.map-title {
  font-size: 30rpx;
  font-weight: 900;
}

.route-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 130rpx;
}

.route-point {
  width: 62rpx;
  height: 62rpx;
}

.route-road {
  flex: 1;
  height: 8rpx;
  border-radius: 999rpx;
  background: repeating-linear-gradient(90deg, #dce2ec 0, #dce2ec 18rpx, transparent 18rpx, transparent 30rpx);
}

.route-bike {
  width: 58rpx;
  height: 58rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 900;
}
