<view class="page">
  <view wx:if="{{loading}}" class="card empty">
    <text class="empty-title">正在加载跟踪</text>
    <text class="muted">请稍候，系统正在同步配送状态。</text>
  </view>

  <view wx:elif="{{errorText}}" class="empty card">
    <text class="empty-title">加载失败</text>
    <text class="muted">{{errorText}}</text>
    <button class="primary-btn" bindtap="loadOrder">重新加载</button>
  </view>

  <view wx:elif="{{order}}" class="track-card dark-hero">
    <text class="eyebrow">ORDER TRACKING</text>
    <text class="hero-title">{{statusText}}</text>
    <text class="hero-subtitle">{{order.fromAddress}} → {{order.toAddress}}</text>
    <view class="rider-card">
      <view>
        <text class="rider-name">{{order.riderName}}</text>
        <text class="rider-phone">{{order.riderPhone}}</text>
      </view>
      <button class="call-btn" bindtap="callRider">
        <image src="/assets/ui/phone.png" mode="aspectFit" />
        <text>联系骑手</text>
      </button>
    </view>
  </view>

  <view wx:if="{{order}}" class="card timeline">
    <view class="step {{item.done ? 'done' : ''}}" wx:for="{{steps}}" wx:key="key">
      <view class="step-dot">
        <image src="/assets/ui/route.png" mode="aspectFit" />
      </view>
      <view class="step-body">
        <text class="step-title">{{item.title}}</text>
        <text class="step-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{order}}" class="card map-mock">
    <view class="map-title-row"><image src="/assets/ui/route.png" mode="aspectFit" /><text class="map-title">模拟路线</text></view>
    <view class="route-line">
      <image class="route-point" src="/assets/ui/pickup.png" mode="aspectFit" />
      <text class="route-road"></text>
      <image class="route-bike" src="/assets/ui/rider.png" mode="aspectFit" />
      <text class="route-road"></text>
      <image class="route-point" src="/assets/ui/dropoff.png" mode="aspectFit" />
    </view>
    <text class="muted">正式商用时接入腾讯位置服务或微信地图能力。</text>
  </view>

  <view wx:else class="empty card">
    <text class="empty-title">暂无可跟踪订单</text>
    <text class="muted">请先创建一个配送订单。</text>
    <button class="primary-btn" bindtap="goOrder">去下单</button>
  </view>
</view>
