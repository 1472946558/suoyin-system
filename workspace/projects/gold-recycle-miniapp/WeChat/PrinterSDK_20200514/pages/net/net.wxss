/* blecontrol.wxss */

page{
  width: 100%;
  min-height: 100%;
  background: blanchedalmond;
}
.parentstyle {
  margin-left: 38rpx;
  margin-top: 30rpx;
  margin-right: 38rpx;
}
.centerStyle {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.input{
 align-items: center;
 margin-left: 4px;
 padding: 4px;
 width: 80%;
 height: 30px; 
 color: green;
 border: 1px solid slategray;
 border-radius: 8px;
}
.pwd{
 align-items: center;
 padding: 4px;
 width: 75%;
 height: 30px; 
 color: green;
 border: 1px solid slategray;
 border-radius: 8px;
}
.pwdinput{
 align-items: center;
 padding: 4px;
 width: 90%;
 height: 30px; 
 color: #54bec2;
}
.imageStyle{
  width: 25px;
  height: 25px;
}
.text{
 font-size: 30rpx;
 color: #54bec2;
 display: flex;
 align-items: center;
 justify-content: center;
}

.receiver_info_scroll_view{
  width: 90%;
  height: 200px;
  margin-left: 4%;
  margin-right: 4%;
  margin-top: 10px;
  margin-bottom: 25px;
  border: 1px solid black;
}

.result{
  width: 90%;
  height: 150px;
  border: 1px solid black;
  margin-left: 4%;
  margin-bottom: 4%;
  margin-top: 5%
}

button{
  width: 90%;
  margin-left: 5%;
  margin-right: 5%;
}

.switch{
  float: right;
  margin-right: 20px;
  margin-bottom: 16px;
}

text{
  color: #fff;
  display: block;
}

input{
  color: gainsboro;
  float: left;
}

.v_net_ssid{
  width: 100%;
  background:  #fff;
}

.v_net_passw{
  width: 100%;
  background: antiquewhite;
}

.swiper{
  width: 100%;
  height: 100%;
}
.button {
  margin-top: 20px;
  width: 90%;
  background-color: #54bec2;
  color: white;
  border-radius: 98rpx;
  background: bg_red;
}
 
/* 按下变颜色 */
.hover {
  background:  rgb(247, 176, 176);
}
