/* pages/mine/index.wxss - 我的页面 */

.mine-page {
  min-height: 100vh;
}

/* 用户头部 */
.mine-header {
  background: linear-gradient(135deg, #866E23 0%, #BFA15F 100%);
  padding: 96rpx 40rpx 72rpx;
  display: flex;
  align-items: center;
}

.mine-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mine-avatar-guest {
  background: rgba(255, 255, 255, 0.15);
}

.mine-avatar-text {
  font-size: 48rpx;
  font-weight: 600;
  color: #fff;
}

.mine-user {
  flex: 1;
  margin-left: 32rpx;
}

.mine-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.mine-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.mine-login {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 999rpx;
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  line-height: 1.4;
  flex-shrink: 0;
}

/* 菜单 */
.mine-menu {
  padding: 32rpx 32rpx;
}

.mine-menu-card {
  margin-bottom: 24rpx;
  padding: 0;
  overflow: hidden;
}

.mine-menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
}

.mine-menu-icon {
  font-size: 40rpx;
  margin-right: 28rpx;
  width: 56rpx;
  text-align: center;
}

.mine-menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-main);
}

.mine-menu-val {
  font-size: 24rpx;
  color: var(--color-text-sub);
}

.mine-menu-badge {
  background: var(--color-danger);
  color: #fff;
  font-size: 22rpx;
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 999rpx;
  text-align: center;
  padding: 0 12rpx;
  margin-right: 12rpx;
}

.mine-menu-arrow {
  font-size: 40rpx;
  color: var(--color-text-tip);
  margin-left: 16rpx;
}

.mine-divider {
  height: 1rpx;
  background: var(--color-border);
  margin-left: 124rpx;
}

/* 店长入口特殊样式 */
.mine-staff {
  border: 2rpx solid var(--color-primary-light);
  background: linear-gradient(135deg, #FBF6E5 0%, #ffffff 100%);
}

.mine-staff-body {
  flex: 1;
}

.mine-staff-sub {
  font-size: 22rpx;
  color: var(--color-text-sub);
  margin-top: 4rpx;
}

/* 登出 */
.mine-logout {
  padding: 0 32rpx;
}

.mine-logout-btn {
  width: 100%;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  font-weight: 500;
}

/* btn-danger 局部样式 */
.btn-danger {
  background: #fff;
  color: var(--color-danger);
  border: 2rpx solid var(--color-danger);
  border-radius: 999rpx;
}

/* 底部信息 */
.mine-footer {
  text-align: center;
  padding: 64rpx 0 32rpx;
}

.mine-footer-brand {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
  letter-spacing: 6rpx;
}

.mine-footer-ver {
  font-size: 22rpx;
  color: var(--color-text-tip);
  margin-top: 8rpx;
}

.mine-footer-copy {
  font-size: 20rpx;
  color: var(--color-text-tip);
  margin-top: 12rpx;
  line-height: 1.5;
}
