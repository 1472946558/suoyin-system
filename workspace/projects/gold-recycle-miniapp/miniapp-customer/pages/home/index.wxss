/*
 * index.wxss - 顾客端首页样式
 */
.home-page {
  min-height: 100vh;
}

.banner-wrap {
  margin: 32rpx 32rpx 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-swiper {
  width: 100%;
  height: 320rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-placeholder {
  width: 100%;
  height: 320rpx;
  background: linear-gradient(135deg, #866E23 0%, #BFA15F 50%, #866E23 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.banner-brand {
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
}

.banner-tag {
  font-size: 24rpx;
  margin-top: 12rpx;
  opacity: 0.9;
}

.slogan {
  text-align: center;
  padding: 32rpx 32rpx 24rpx;
}

.slogan-brand {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--color-primary);
  letter-spacing: 6rpx;
}

.slogan-divider {
  width: 60rpx;
  height: 4rpx;
  background: var(--color-primary);
  margin: 16rpx auto;
  position: relative;
}
.slogan-divider::before,
.slogan-divider::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  background: var(--color-primary);
  border-radius: 50%;
  transform: translateY(-50%);
}
.slogan-divider::before { left: -16rpx; }
.slogan-divider::after { right: -16rpx; }

.slogan-line1 {
  font-size: 30rpx;
  color: var(--color-text-main);
  font-weight: 500;
}

.slogan-line2 {
  font-size: 24rpx;
  color: var(--color-text-sub);
  margin-top: 12rpx;
}

.entry-card {
  margin: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #FBF6E5 0%, #ffffff 100%);
}

.entry-left {
  flex: 1;
  padding-right: 24rpx;
}

.entry-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.entry-sub {
  font-size: 26rpx;
  color: var(--color-text-sub);
  margin-top: 8rpx;
  line-height: 1.5;
}

.entry-btn {
  margin-top: 24rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  display: inline-block;
  width: auto;
}

.entry-right {
  display: flex;
  align-items: center;
}

.entry-thumb {
  background: linear-gradient(135deg, #F4D58D 0%, #BFA15F 100%);
  border-radius: 12rpx;
}

.entry-thumb-lg {
  width: 160rpx;
  height: 200rpx;
  margin-right: 12rpx;
}

.entry-thumb-stack {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.entry-thumb-sm {
  width: 100rpx;
  height: 94rpx;
}

.stores-card {
  margin: 24rpx 32rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
}

.section-more {
  font-size: 24rpx;
  color: var(--color-text-sub);
}

.store-card {
  display: flex;
  padding: 24rpx;
  background: #FAFAFA;
  border-radius: 16rpx;
}

.store-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #3a2a0c 0%, #6b4f1d 100%);
  flex-shrink: 0;
}

.store-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.store-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.store-distance {
  display: inline-block;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
  align-self: flex-start;
}

.store-address {
  font-size: 24rpx;
  color: var(--color-text-sub);
  margin-top: 8rpx;
  line-height: 1.4;
}

.store-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.store-action-btn {
  flex: 1;
  padding: 16rpx 0;
  font-size: 26rpx;
}

.home-footer {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-tip);
  padding: 32rpx 0 0;
}
