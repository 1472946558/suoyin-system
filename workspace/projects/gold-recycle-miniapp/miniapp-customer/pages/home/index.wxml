<view class="page home-page">
  <!-- 顶部品牌栏 -->
  <view class="home-topbar">
    <text class="home-topbar-title">{{homeData.brandName || '金匠倌'}}</text>
    <view class="home-topbar-icons">
      <view class="home-topbar-icon" bindtap="onTapMore">
        <text>···</text>
      </view>
      <view class="home-topbar-icon" bindtap="onTapScan">
        <text>⊙</text>
      </view>
    </view>
  </view>

  <!-- Banner 轮播 -->
  <view class="banner-wrap" wx:if="{{homeData.banners && homeData.banners.length > 0}}">
    <swiper class="banner-swiper" indicator-dots autoplay interval="3500" duration="500" circular>
      <swiper-item wx:for="{{homeData.banners}}" wx:key="imageUrl" bindtap="onBannerTap" data-index="{{index}}">
        <image class="banner-image" src="{{item.imageUrl}}" mode="aspectFill" />
      </swiper-item>
    </swiper>
  </view>
  <view class="banner-wrap" wx:else>
    <view class="banner-placeholder">
      <text class="banner-brand">{{homeData.brandName || '金匠倌'}}</text>
      <text class="banner-tag">匠心传承 精工品质</text>
    </view>
  </view>

  <!-- 品牌标语 -->
  <view class="slogan">
    <view class="slogan-brand">{{homeData.brandName || '金匠倌'}}</view>
    <view class="slogan-divider"></view>
    <view class="slogan-line1">{{homeData.brandSlogan1 || '旧金换打新款'}} · {{homeData.brandSlogan2 || '包损耗'}}</view>
    <view class="slogan-line2">黄金维修 · 到店回收 · 款式定制</view>
  </view>

  <!-- 款式图 / 工费 入口 -->
  <view class="card entry-card" bindtap="onTapProducts">
    <view class="entry-left">
      <view class="entry-title">款式图 / 工费</view>
      <view class="entry-sub">海量款式 · 工费透明</view>
      <view class="entry-sub">一目了然</view>
      <view class="btn-primary entry-btn">点击查看 ›</view>
    </view>
    <view class="entry-right">
      <view class="entry-thumb entry-thumb-lg"></view>
      <view class="entry-thumb-stack">
        <view class="entry-thumb entry-thumb-sm"></view>
        <view class="entry-thumb entry-thumb-sm"></view>
      </view>
    </view>
  </view>

  <!-- 附近门店 -->
  <view class="card stores-card">
    <view class="section-head">
      <view class="row">
        <view class="section-icon">📍</view>
        <text class="section-title">附近门店</text>
      </view>
      <view class="section-more" bindtap="onTapMoreStores">
        <text>更多门店</text>
        <text> ›</text>
      </view>
    </view>
    <view wx:if="{{nearestStore}}" class="store-card" bindtap="onTapStore" data-store="{{nearestStore}}">
      <image class="store-thumb" src="{{nearestStore.thumb || ''}}" mode="aspectFill" />
      <view class="store-info">
        <view class="store-name">{{nearestStore.name}}</view>
        <view class="store-distance" wx:if="{{nearestStore.distance}}">距您 {{nearestStore.distanceText}}</view>
        <view class="store-address">📍 {{nearestStore.address}}</view>
        <view class="store-actions">
          <view class="btn-primary store-action-btn" catchtap="onTapAppointment" data-store="{{nearestStore}}">
            <text>📅 到店预约</text>
          </view>
          <view class="btn-outline store-action-btn" catchtap="onTapNavigate" data-store="{{nearestStore}}">
            <text>➤ 地图导航</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="empty">
      <text>暂无附近门店</text>
    </view>
  </view>

  <view class="home-footer">
    <text>客服电话：{{servicePhone}}</text>
  </view>
</view>
