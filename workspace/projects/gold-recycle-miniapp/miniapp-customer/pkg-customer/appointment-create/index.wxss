/* pkg-customer/appointment-create/index.wxss - 到店预约创建页 */

.ac-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 180rpx;
}

/* 通用 section */
.ac-section {
  position: relative;
  margin-bottom: 24rpx;
  padding: 32rpx;
}

.ac-section-num {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  display: none; /* 编号仅占位 */
}

.ac-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 24rpx;
}

.ac-section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 20rpx;
}

.ac-section-hint {
  font-size: 22rpx;
  color: var(--color-text-tip);
  font-weight: 400;
}

/* 门店卡 */
.ac-store-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: var(--color-primary-bg);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-primary-light);
}

.ac-store-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.ac-store-img-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #F4D58D 0%, #BFA15F 60%, #866E23 100%);
  color: #fff;
}

.ac-store-img-text {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.ac-store-info {
  flex: 1;
  min-width: 0;
}

.ac-store-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.ac-store-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.ac-store-change {
  font-size: 22rpx;
  color: var(--color-primary);
  padding: 4rpx 16rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 999rpx;
}

.ac-store-addr {
  font-size: 24rpx;
  color: var(--color-text-sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 服务类型 */
.ac-service-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.ac-service-item {
  width: calc(50% - 10rpx);
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.ac-service-active {
  background: var(--color-primary-bg);
  border-color: var(--color-primary);
}

.ac-service-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.ac-service-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-main);
}

/* 日期选择 */
.ac-date-scroll {
  width: 100%;
  white-space: nowrap;
}

.ac-date-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx;
}

.ac-date-item {
  flex-shrink: 0;
  width: 120rpx;
  padding: 20rpx 0;
  background: #F9F9F9;
  border-radius: 16rpx;
  text-align: center;
  border: 4rpx solid transparent;
}

.ac-date-active {
  background: var(--color-primary-bg);
  border-color: var(--color-primary);
}

.ac-date-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.ac-date-sub {
  font-size: 22rpx;
  color: var(--color-text-sub);
  margin-top: 6rpx;
}

/* 时段 */
.ac-slot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ac-slot-item {
  width: calc(33.333% - 12rpx);
  padding: 20rpx 0;
  background: #F9F9F9;
  border-radius: 12rpx;
  text-align: center;
  border: 4rpx solid transparent;
  position: relative;
}

.ac-slot-active {
  background: var(--color-primary-bg);
  border-color: var(--color-primary);
}

.ac-slot-disabled {
  opacity: 0.4;
}

.ac-slot-time {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.ac-slot-status {
  font-size: 20rpx;
  color: var(--color-text-tip);
  margin-top: 4rpx;
}

.ac-slot-avail {
  color: var(--color-success);
}

.ac-slot-empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--color-text-tip);
  font-size: 26rpx;
}

/* 手机号输入 */
.ac-input-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.ac-input-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.ac-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-main);
  height: 56rpx;
  line-height: 56rpx;
}

.ac-input-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
  line-height: 1.4;
}

.ac-input-btn-primary {
  background: var(--color-primary);
  color: #fff;
  border: none;
}

.ac-input-btn-primary::after {
  border: none;
}

.ac-input-btn-verified {
  background: #E8F5E9;
  color: var(--color-success);
  border: 1rpx solid #C8E6C9;
}

.ac-input-divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 0;
}

.ac-input-tip {
  font-size: 22rpx;
  color: var(--color-text-tip);
  margin-top: 8rpx;
}

/* 协议 */
.ac-agreement {
  display: flex;
  align-items: center;
  padding: 16rpx 8rpx;
}

.ac-agreement-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: transparent;
  margin-right: 12rpx;
  flex-shrink: 0;
  transition: all 0.2s;
}

.ac-agreement-checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}

.ac-agreement-text {
  font-size: 24rpx;
  color: var(--color-text-sub);
}

.ac-agreement-link {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* 备注 */
.ac-remark-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: var(--color-text-main);
  line-height: 1.6;
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.ac-placeholder {
  color: var(--color-text-tip);
  font-size: 26rpx;
}

.ac-remark-counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-tip);
  margin-top: 8rpx;
}

/* 提交 */
.ac-submit-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(134, 110, 35, 0.08);
  z-index: 100;
}

.ac-submit-btn {
  width: 100%;
}

.ac-submit-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tip);
  margin-top: 12rpx;
}
