<view class="page apt-page">

  <!-- 未登录 -->
  <view wx:if="{{!isLoggedIn}}" class="apt-empty">
    <view class="apt-empty-icon">📅</view>
    <view class="apt-empty-text">查看我的预约</view>
    <view class="apt-empty-sub">登录后可查看您的预约记录</view>
    <view class="btn-primary apt-empty-btn" bindtap="onLogin">去预约 / 登录</view>
  </view>

  <block wx:else>
    <!-- 状态筛选 -->
    <view class="apt-tabs">
      <view
        class="apt-tab {{activeTab === item.key ? 'apt-tab-active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onTabChange"
      >
        {{item.label}}
      </view>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="apt-loading">
      <text>加载中...</text>
    </view>

    <!-- 空列表 -->
    <view wx:elif="{{filteredList.length === 0}}" class="apt-empty">
      <view class="apt-empty-icon">📋</view>
      <view class="apt-empty-text">暂无预约记录</view>
      <view class="btn-outline apt-empty-btn" bindtap="onNewAppointment">去预约</view>
    </view>

    <!-- 预约列表 -->
    <view wx:else class="apt-list">
      <view
        class="card apt-card"
        wx:for="{{filteredList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onTapItem"
      >
        <view class="apt-card-top">
          <text class="apt-store">{{item.storeName || '门店'}}</text>
          <view class="apt-status" style="background: {{item.statusBgColor}}; color: {{item.statusColor}};">{{item.statusText}}</view>
        </view>
        <view class="apt-svc">
          <text class="tag">{{item.serviceText}}</text>
        </view>
        <view class="apt-time">
          <text class="apt-date">{{item.appointmentDate}}</text>
          <text class="apt-slot">{{item.timeRange}}</text>
        </view>
        <view class="apt-addr" wx:if="{{item.storeAddress}}">{{item.storeAddress}}</view>
        <view class="apt-cancel" wx:if="{{item.status === 'CANCELLED' && item.cancelReason}}">
          取消原因：{{item.cancelReason}}
        </view>
        <view class="apt-arrow">›</view>
      </view>
    </view>

    <!-- 新建预约 FAB -->
    <view class="apt-fab" bindtap="onNewAppointment">
      <text>+ 预约</text>
    </view>
  </block>
</view>
