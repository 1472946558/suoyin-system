/* pkg-customer/appointments/index.wxss - 我的预约列表页 */

.apt-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 未登录 */
.apt-not-logged {
  padding: 200rpx 40rpx;
  text-align: center;
}

.apt-nl-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.apt-nl-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.apt-nl-desc {
  font-size: 26rpx;
  color: var(--color-text-sub);
  margin-top: 12rpx;
}

.apt-nl-btn {
  width: 320rpx;
  margin: 40rpx auto 0;
}

/* 状态筛选 */
.apt-tabs {
  display: flex;
  background: #fff;
  padding: 0 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.apt-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: var(--color-text-sub);
  position: relative;
}

.apt-tab-active {
  color: var(--color-primary);
  font-weight: 600;
}

.apt-tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}

/* 空状态 */
.apt-empty {
  padding: 160rpx 40rpx;
  text-align: center;
}

.apt-empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.apt-empty-text {
  font-size: 28rpx;
  color: var(--color-text-tip);
}

.apt-empty-btn {
  width: 240rpx;
  margin: 32rpx auto 0;
}

/* 预约列表 */
.apt-list {
  padding: 24rpx 32rpx;
}

.apt-item {
  margin-bottom: 20rpx;
  padding: 28rpx 32rpx;
  position: relative;
}

.apt-item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.apt-item-store {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.apt-item-status {
  font-size: 26rpx;
  font-weight: 600;
}

.apt-item-service {
  margin-bottom: 12rpx;
}

.apt-item-time {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.apt-item-date {
  font-size: 26rpx;
  color: var(--color-text-main);
}

.apt-item-slot {
  font-size: 24rpx;
  color: var(--color-text-sub);
}

.apt-item-arrow {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: var(--color-text-tip);
}

/* FAB */
.apt-fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 999rpx;
  padding: 24rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(134, 110, 35, 0.3);
  z-index: 100;
}

.apt-fab-text {
  font-size: 28rpx;
  font-weight: 500;
}
