<view class="page ad-page">

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="ad-empty">
    <text class="ad-empty-text">加载中...</text>
  </view>

  <!-- 错误 -->
  <view wx:elif="{{error}}" class="ad-empty">
    <text class="ad-empty-text">{{error}}</text>
  </view>

  <block wx:elif="{{detail}}">
    <!-- 状态头部 -->
    <view class="ad-status-bar ad-status-{{detail.status}}">
      <view class="ad-status-icon">
        <text wx:if="{{detail.status === 'PENDING'}}">⏳</text>
        <text wx:elif="{{detail.status === 'CONFIRMED'}}">✓</text>
        <text wx:elif="{{detail.status === 'ARRIVED'}}">🏪</text>
        <text wx:elif="{{detail.status === 'COMPLETED'}}">✓</text>
        <text wx:elif="{{detail.status === 'CANCELLED'}}">✕</text>
        <text wx:elif="{{detail.status === 'NO_SHOW'}}">!</text>
        <text wx:elif="{{detail.status === 'TERMINATED'}}">✕</text>
      </view>
      <view class="ad-status-text">{{statusText}}</view>
      <view class="ad-status-no">预约号：{{detail.appointmentNo || detail.id}}</view>
    </view>

    <!-- 预约信息 -->
    <view class="card ad-card">
      <view class="ad-row">
        <text class="ad-label">服务类型</text>
        <text class="ad-value">{{serviceText}}</text>
      </view>
      <view class="ad-row">
        <text class="ad-label">预约门店</text>
        <text class="ad-value">{{detail.storeName}}</text>
      </view>
      <view class="ad-row" wx:if="{{detail.storeAddress}}">
        <text class="ad-label">门店地址</text>
        <text class="ad-value ad-value-sub">{{detail.storeAddress}}</text>
      </view>
      <view class="ad-row">
        <text class="ad-label">预约日期</text>
        <text class="ad-value">{{detail.appointmentDate}}</text>
      </view>
      <view class="ad-row">
        <text class="ad-label">预约时段</text>
        <text class="ad-value">{{detail.timeRange}}</text>
      </view>
    </view>

    <!-- 联系电话 -->
    <view class="card ad-card" wx:if="{{contactPhone}}">
      <view class="ad-row">
        <text class="ad-label">联系电话</text>
        <text class="ad-value ad-value-phone" bindtap="onCallSelf">{{contactPhone}}</text>
      </view>
    </view>

    <!-- 门店操作 -->
    <view class="card ad-card" wx:if="{{detail.storePhone || detail.storeId}}">
      <view class="ad-store-actions">
        <view class="btn-outline ad-store-btn" bindtap="onCallStore" wx:if="{{detail.storePhone}}">
          <text>📞 联系门店</text>
        </view>
        <view class="btn-outline ad-store-btn" bindtap="onNavigate" wx:if="{{detail.storeId}}">
          <text>📍 门店位置</text>
        </view>
      </view>
    </view>

    <!-- 备注 -->
    <view class="card ad-card">
      <view class="ad-remark-head">
        <text class="ad-label ad-label-auto">备注</text>
        <text class="ad-edit" bindtap="onEditNotes" wx:if="{{canEditNotes}}">修改 ›</text>
      </view>
      <view class="ad-remark-body">
        <text wx:if="{{detail.remark}}">{{detail.remark}}</text>
        <text class="ad-remark-empty" wx:else>无备注</text>
      </view>
    </view>

    <!-- 取消信息 -->
    <view class="card ad-card ad-cancel-info" wx:if="{{detail.status === 'CANCELLED' && detail.cancelReason}}">
      <view class="ad-row">
        <text class="ad-label">取消原因</text>
        <text class="ad-value ad-value-danger">{{detail.cancelReason}}</text>
      </view>
      <view class="ad-row" wx:if="{{detail.cancelledAt}}">
        <text class="ad-label">取消时间</text>
        <text class="ad-value ad-value-sub">{{detail.cancelledAt}}</text>
      </view>
    </view>

    <!-- 确认信息 -->
    <view class="card ad-card" wx:if="{{detail.confirmedAt && detail.status !== 'CANCELLED'}}">
      <view class="ad-row">
        <text class="ad-label">确认时间</text>
        <text class="ad-value ad-value-sub">{{detail.confirmedAt}}</text>
      </view>
    </view>

    <!-- 创建信息 -->
    <view class="card ad-card ad-meta">
      <view class="ad-row">
        <text class="ad-label">创建时间</text>
        <text class="ad-value ad-value-sub">{{detail.createdAt || '-'}}</text>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="ad-cta" wx:if="{{canCancel || canEditNotes}}">
      <view class="btn-outline ad-cta-btn" bindtap="onEditNotes" wx:if="{{canEditNotes}}">
        <text>修改备注</text>
      </view>
      <view class="btn-danger ad-cta-btn" bindtap="onCancel" wx:if="{{canCancel}}">
        <text>取消预约</text>
      </view>
    </view>
  </block>
</view>
