<view class="page notes-page">
  <view class="card notes-card">
    <view class="notes-label">预约备注</view>
    <view class="notes-input-wrap">
      <textarea
        class="notes-input"
        placeholder="可填写您的需求描述，如旧金品类、大致克重、期望到店时间等（选填）"
        placeholder-class="notes-placeholder"
        value="{{remark}}"
        bindinput="onInput"
        maxlength="200"
        auto-height
        show-confirm-bar="{{false}}"
        adjust-position="{{true}}"
      />
    </view>
    <view class="notes-counter">{{remark.length}} / 200</view>
  </view>

  <view class="notes-actions">
    <view class="btn-outline notes-btn-clear" bindtap="onClear" wx:if="{{remark}}">清空</view>
    <view class="btn-primary notes-btn-save {{saving ? 'btn-disabled' : ''}}" bindtap="onSave">
      {{saving ? '保存中...' : '保存'}}
    </view>
  </view>
</view>
