<view class="page notes-page">

  <view class="card notes-card">
    <view class="notes-label">预约备注</view>
    <view class="notes-area">
      <textarea
        class="notes-textarea"
        placeholder="可填写您的需求描述，如旧金品类、大致克重、期望到店时间等（选填）"
        value="{{remark}}"
        bindinput="onInput"
        maxlength="200"
        auto-height
      ></textarea>
    </view>
    <view class="notes-count">{{remark.length}} / 200</view>
  </view>

  <view class="notes-actions">
    <view class="btn-outline notes-btn-clear" bindtap="onClear">清空</view>
    <view class="btn-primary notes-btn-save" bindtap="onSave">保存</view>
  </view>
</view>
