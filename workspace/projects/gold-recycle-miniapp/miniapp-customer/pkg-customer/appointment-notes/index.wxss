/* pkg-customer/appointment-notes/index.wxss - 修改预约备注页 */

.notes-page {
  min-height: 100vh;
  padding: 24rpx 32rpx;
}

.notes-card {
  padding: 32rpx;
}

.notes-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 20rpx;
}

.notes-input-wrap {
  background: #F9F9F9;
  border-radius: 16rpx;
  padding: 24rpx;
  min-height: 200rpx;
}

.notes-input {
  width: 100%;
  min-height: 180rpx;
  font-size: 28rpx;
  color: var(--color-text-main);
  line-height: 1.6;
}

.notes-placeholder {
  color: var(--color-text-tip);
  font-size: 26rpx;
}

.notes-counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-tip);
  margin-top: 12rpx;
}

.notes-actions {
  margin-top: 40rpx;
  display: flex;
  gap: 20rpx;
}

.notes-btn-clear {
  width: 200rpx;
  flex-shrink: 0;
}

.notes-btn-save {
  flex: 1;
}
