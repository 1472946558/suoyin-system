@import "../../styles/customer.wxss";

/* pages/stores/index.wxss - 附近门店列表页 */

.stores-page {
  min-height: 100vh;
}

/* 定位栏 */
.loc-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-bg-card);
  padding: 20rpx 32rpx;
}

.loc-bar-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.loc-pin {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.loc-text {
  font-size: 26rpx;
  color: var(--color-text-main);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-bar-btn {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.loc-bar-btn-icon {
  margin-right: 6rpx;
}

/* 提示条 */
.loc-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF7E6;
  border-bottom: 1rpx solid #FFE0A0;
  padding: 16rpx 32rpx;
}

.loc-tip-text {
  font-size: 24rpx;
  color: #FF9800;
}

.loc-tip-action {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* 搜索栏 */
.search-bar {
  background: var(--color-bg-card);
  padding: 16rpx 32rpx 20rpx;
}

.search-input {
  display: flex;
  align-items: center;
  background: var(--color-bg);
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 32rpx;
  color: var(--color-text-sub);
  margin-right: 12rpx;
}

.search-field {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-main);
  height: 72rpx;
  line-height: 72rpx;
}

.search-placeholder {
  color: var(--color-text-tip);
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--color-text-tip);
  background: #E0E0E0;
  border-radius: 50%;
}

/* 段落 */
.section {
  padding: 24rpx 24rpx 0;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 16rpx;
}

.section-pin {
  color: var(--color-warning);
  margin-right: 8rpx;
}

/* 离你最近 */
.nearest-card {
  padding: 0;
  overflow: hidden;
}

.nearest-head {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
}

.nearest-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.nearest-img-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #F4D58D 0%, #BFA15F 60%, #866E23 100%);
  color: #fff;
}

.nearest-img-pic {
  width: 100%;
  height: 100%;
  display: block;
}

.nearest-img-text {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.nearest-main {
  flex: 1;
  min-width: 0;
}

.nearest-row1 {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.nearest-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-right: 12rpx;
}

.nearest-tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: var(--color-success);
  background: #E8F5E9;
  border: 1rpx solid #C8E6C9;
  border-radius: 6rpx;
}

.nearest-tag-off {
  color: var(--color-text-tip);
  background: #F5F5F5;
  border-color: #E0E0E0;
}

.nearest-addr,
.nearest-hours {
  font-size: 24rpx;
  color: var(--color-text-sub);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.nearest-dist {
  font-size: 26rpx;
  color: var(--color-text-sub);
  margin-left: 12rpx;
  flex-shrink: 0;
}

.nearest-actions {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 24rpx;
}

/* 列表卡片 */
.store-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.store-item {
  padding: 0;
  overflow: hidden;
}

.store-head {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
}

.store-img {
  width: 144rpx;
  height: 144rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.store-img-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #F4D58D 0%, #BFA15F 60%, #866E23 100%);
  color: #fff;
}

.store-img-pic {
  width: 100%;
  height: 100%;
  display: block;
}

.store-img-text {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.store-main {
  flex: 1;
  min-width: 0;
}

.store-row1 {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.store-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-main);
}

.store-dist {
  font-size: 24rpx;
  color: var(--color-text-sub);
  flex-shrink: 0;
}

.store-addr,
.store-hours {
  font-size: 24rpx;
  color: var(--color-text-sub);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.store-appt {
  margin-top: 6rpx;
}

.store-appt-off {
  font-size: 20rpx;
  color: var(--color-text-tip);
}

.store-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 20rpx 20rpx;
}

/* 按钮 */
.act-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  flex: 1;
}

.act-btn-solid {
  background: var(--color-primary);
  color: #fff;
}

.act-btn-ghost {
  background: #fff;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.act-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}

.act-phone {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-primary-light);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.act-phone-icon {
  font-size: 28rpx;
}

/* 空状态 */
.retry-btn {
  width: 240rpx;
  margin: 24rpx auto 0;
  padding: 16rpx 0;
  font-size: 26rpx;
}

/* 底部空间 */
.bottom-spacer {
  height: 0;
}
