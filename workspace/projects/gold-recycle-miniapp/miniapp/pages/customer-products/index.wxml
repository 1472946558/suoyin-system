<view class="page products-page page-bottom-safe">
  <!-- 顶部搜索栏 -->
  <view class="search-bar">
    <view class="search-input">
      <text class="search-icon">⌕</text>
      <input
        class="search-field"
        type="text"
        placeholder="搜索款式、品类、工费"
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="onClearSearch">×</text>
    </view>
  </view>

  <!-- 分类筛选标签栏 -->
  <scroll-view class="cat-bar" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      class="cat-item {{activeCategory === item ? 'cat-item-active' : ''}}"
      wx:for="{{categories}}"
      wx:key="*this"
      data-cat="{{item}}"
      bindtap="onCategoryTap"
    >{{item}}</view>
  </scroll-view>

  <!-- 工费说明提示 -->
  <view class="notice-banner">
    <text class="notice-icon">📣</text>
    <text class="notice-text">工费以门店最终确认为准，线上仅作参考</text>
  </view>

  <!-- 商品网格 -->
  <view wx:if="{{products.length > 0}}" class="grid">
    <view
      class="p-card"
      wx:for="{{products}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onProductTap"
    >
      <view class="p-thumb">
        <image wx:if="{{item.imageUrl}}" class="p-img" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
        <view wx:else class="p-img p-img-placeholder center">
          <text class="p-placeholder-text">金匠倌</text>
        </view>
        <view wx:if="{{item.showHot}}" class="p-badge p-badge-hot">热门</view>
        <view wx:elif="{{item.showRecommended}}" class="p-badge p-badge-rec">推荐</view>
      </view>
      <view class="p-body">
        <view class="p-name">{{item.name}}</view>
        <view class="p-meta">
          <text class="p-cat">{{item.category}}</text>
          <text class="p-purity" wx:if="{{item.purity}}">{{item.purity}}</text>
        </view>
        <view class="p-price-row">
          <text class="p-price">{{item.priceText}}</text>
          <text class="p-gram" wx:if="{{item.gramText}}">{{item.gramText}}</text>
        </view>
        <view class="p-labor" wx:if="{{item.laborFeeText}}">
          <text class="p-labor-label">工费参考</text>
          <text class="p-labor-val">{{item.laborFeeText}}</text>
        </view>
        <view class="p-tagline" wx:if="{{item.tagText}}">{{item.tagText}}</view>
        <view class="p-action" catchtap="onProductTap" data-id="{{item.id}}">
          <text>查看详情</text>
          <text class="p-action-arrow"> ›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 / 失败重试 -->
  <view wx:elif="{{!loading}}" class="empty">
    <text>{{error || '暂无商品'}}</text>
    <view wx:if="{{error}}" class="btn-outline retry-btn" bindtap="onRetry">重新加载</view>
  </view>

  <!-- 加载更多状态 -->
  <view class="load-more">
    <text wx:if="{{loading}}">加载中...</text>
    <text wx:elif="{{!hasMore && products.length > 0}}">— 已加载全部 —</text>
  </view>
</view>
