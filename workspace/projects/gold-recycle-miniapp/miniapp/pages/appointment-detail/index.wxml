<!-- 预约详情页 -->
<view class="page appt-detail-page">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="muted">加载中...</text>
  </view>

  <block wx:if="{{!loading && appt}}">
    <!-- 状态头部 -->
    <view class="card status-hero">
      <view class="status-hero-row">
        <text class="status-hero-label">当前状态</text>
        <text class="appt-status {{appt.statusClass}}">{{appt.statusText}}</text>
      </view>
      <text class="status-hero-no">预约编号：{{appt.appointmentNo}}</text>
    </view>

    <!-- 顾客信息 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">顾客信息</text>
      </view>
      <view class="info-row">
        <text class="info-label">姓名</text>
        <text class="info-value">{{appt.customerName}}</text>
      </view>
      <view class="info-row" wx:if="{{appt.customerPhone}}">
        <text class="info-label">电话</text>
        <view class="info-phone-wrap">
          <text class="info-value">{{appt.customerPhone}}</text>
          <view class="call-btn" bindtap="onCallCustomer">
            <text>拨打</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 预约信息 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">预约信息</text>
      </view>
      <view class="info-row">
        <text class="info-label">服务类型</text>
        <text class="info-value">{{appt.serviceTypeText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">预约日期</text>
        <text class="info-value">{{appt.appointmentDate}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">预约时段</text>
        <text class="info-value">{{appt.appointmentTime}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">门店</text>
        <text class="info-value">{{appt.storeName}}</text>
      </view>
      <view class="info-row" wx:if="{{appt.remark}}">
        <text class="info-label">备注</text>
        <text class="info-value info-remark">{{appt.remark}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view wx:if="{{actions.length > 0}}" class="action-bar">
      <view wx:for="{{actions}}" wx:key="status"
            class="action-btn action-{{item.type}}"
            bindtap="onAction" data-status="{{item.status}}" data-label="{{item.label}}">
        <text>{{item.label}}</text>
      </view>
    </view>

    <!-- 无操作提示 -->
    <view wx:if="{{actions.length === 0}}" class="card empty-card">
      <text class="muted">该预约当前状态无可用操作</text>
    </view>
  </block>

  <!-- 加载失败 -->
  <view wx:if="{{!loading && !appt}}" class="card empty-card">
    <text class="empty-title">加载失败</text>
    <text class="muted">请返回列表页重试</text>
  </view>
</view>
