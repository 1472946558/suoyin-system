<!-- 预约列表页 -->
<view class="page appt-list-page">
  <!-- 状态筛选 -->
  <scroll-view class="tab-bar" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="tab-item {{activeTab === item.key ? 'active' : ''}}"
          wx:for="{{tabs}}" wx:key="key"
          bindtap="onTabChange" data-key="{{item.key}}">
      <text>{{item.label}}</text>
    </view>
  </scroll-view>

  <!-- 列表 -->
  <view wx:if="{{!loading && !isEmpty}}" class="appt-list">
    <view class="appt-card" wx:for="{{list}}" wx:key="id"
          bindtap="onTapCard" data-id="{{item.id}}">
      <view class="appt-card-head">
        <text class="appt-no">{{item.appointmentNo}}</text>
        <text class="appt-status {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="appt-card-body">
        <view class="appt-info-row">
          <text class="appt-label">顾客</text>
          <text class="appt-value">{{item.customerName}}</text>
        </view>
        <view class="appt-info-row" wx:if="{{item.customerPhone}}">
          <text class="appt-label">电话</text>
          <text class="appt-value appt-phone" catchtap="onCallCustomer" data-phone="{{item.customerPhone}}">{{item.customerPhone}}</text>
        </view>
        <view class="appt-info-row">
          <text class="appt-label">服务</text>
          <text class="appt-value">{{item.serviceTypeText}}</text>
        </view>
        <view class="appt-info-row">
          <text class="appt-label">时间</text>
          <text class="appt-value">{{item.appointmentDate}} {{item.appointmentTime}}</text>
        </view>
        <view class="appt-info-row" wx:if="{{item.remark}}">
          <text class="appt-label">备注</text>
          <text class="appt-value appt-remark">{{item.remark}}</text>
        </view>
      </view>
      <view class="appt-card-foot">
        <text class="appt-store">{{item.storeName}}</text>
        <text class="appt-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && isEmpty}}" class="card empty-card">
    <text class="empty-title">暂无预约</text>
    <text class="muted">当前筛选条件下没有预约记录</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="muted">加载中...</text>
  </view>

  <!-- 底部计数 -->
  <view wx:if="{{!loading && !isEmpty && total > 0}}" class="list-count">
    <text class="muted">共 {{total}} 条预约</text>
  </view>
</view>
