<view class="page product-detail-page">
  <view class="detail-hero">
    <view class="detail-image-box">
      <image class="detail-image" src="{{product.imageUrl || '/assets/ui/price.png'}}" mode="aspectFit" />
    </view>
    <view class="detail-hero-copy">
      <text class="detail-title">{{product.name}}</text>
      <text class="detail-code">{{product.sku}} · {{product.purity}}</text>
      <text class="detail-status {{product.status}}">{{product.statusText}}</text>
    </view>
  </view>

  <view class="detail-section">
    <text class="section-title-text">报价与数量</text>
    <view class="detail-grid">
      <view class="detail-cell">
        <text class="detail-label">参考回收价</text>
        <text class="detail-value">{{product.benchPriceText}}</text>
      </view>
      <view class="detail-cell">
        <text class="detail-label">销售参考价</text>
        <text class="detail-value">{{product.retailPriceText}}</text>
      </view>
      <view class="detail-cell">
        <text class="detail-label">商品数量</text>
        <text class="detail-value">{{product.inventory}}</text>
      </view>
      <view class="detail-cell">
        <text class="detail-label">克重模板</text>
        <text class="detail-value">{{product.gramWeightText}}</text>
      </view>
    </view>
  </view>

  <view class="detail-section">
    <text class="section-title-text">商品信息</text>
    <view class="info-list">
      <view class="info-row">
        <text class="detail-label">分类</text>
        <text class="info-value">{{product.category}}</text>
      </view>
      <view class="info-row">
        <text class="detail-label">可见门店</text>
        <text class="info-value">{{product.storesText}}</text>
      </view>
      <view class="info-row">
        <text class="detail-label">报价时效</text>
        <text class="info-value">{{product.quoteLeadTime}}</text>
      </view>
    </view>
    <view class="tag-row">
      <text wx:for="{{product.tags}}" wx:key="*this" class="detail-tag">{{item}}</text>
    </view>
  </view>

  <view class="detail-section">
    <text class="section-title-text">使用说明</text>
    <text class="detail-note">{{product.recommendedScene}}</text>
  </view>

  <view class="detail-actions">
    <button class="detail-secondary-btn" bindtap="copySku">复制 SKU</button>
    <button class="detail-secondary-btn" bindtap="editProduct">编辑</button>
    <button class="detail-primary-btn" bindtap="useForRecycle">带入录单</button>
  </view>
</view>
