@import "../../styles/customer.wxss";

/* pkg-customer/appointments/index.wxss - 我的预约列表页 */

.apt-page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 状态筛选 */
.apt-tabs {
  display: flex;
  background: #fff;
  padding: 0 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid var(--color-border);
}

.apt-tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 26rpx;
  color: var(--color-text-sub);
  position: relative;
}

.apt-tab-active {
  color: var(--color-primary);
  font-weight: 600;
}

.apt-tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}

/* 加载中 */
.apt-loading {
  padding: 120rpx 0;
  text-align: center;
  color: var(--color-text-tip);
  font-size: 28rpx;
}

/* 空状态 */
.apt-empty {
  padding: 200rpx 40rpx;
  text-align: center;
}

.apt-empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.apt-empty-text {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-main);
}

.apt-empty-sub {
  font-size: 26rpx;
  color: var(--color-text-sub);
  margin-top: 12rpx;
}

.apt-empty-btn {
  width: 320rpx;
  margin: 40rpx auto 0;
}

/* 预约列表 */
.apt-list {
  padding: 24rpx 32rpx;
}

.apt-card {
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
  position: relative;
}

.apt-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.apt-store {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.apt-status {
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
}

.apt-svc {
  margin-bottom: 12rpx;
}

.apt-time {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.apt-date {
  font-size: 26rpx;
  color: var(--color-text-main);
}

.apt-slot {
  font-size: 24rpx;
  color: var(--color-text-sub);
}

.apt-addr {
  font-size: 24rpx;
  color: var(--color-text-tip);
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 48rpx;
}

.apt-cancel {
  font-size: 24rpx;
  color: var(--color-danger);
  margin-top: 8rpx;
}

.apt-arrow {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: var(--color-text-tip);
}

/* FAB */
.apt-fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 999rpx;
  padding: 24rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(134, 110, 35, 0.35);
  z-index: 100;
  font-size: 28rpx;
  font-weight: 500;
}
