@import "../../styles/customer.wxss";

/* pkg-customer/appointment-notes/index.wxss - 预约备注修改页 */

.notes-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.notes-card {
  margin: 24rpx 32rpx;
  padding: 40rpx 32rpx;
}

.notes-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 24rpx;
}

.notes-area {
  background: #F9F9F9;
  border-radius: 20rpx;
  padding: 28rpx;
  min-height: 200rpx;
}

.notes-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: var(--color-text-main);
  line-height: 1.6;
}

.notes-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-tip);
  margin-top: 16rpx;
}

.notes-actions {
  padding: 0 32rpx;
  margin-top: 32rpx;
  display: flex;
  gap: 24rpx;
}

.notes-btn-clear {
  width: 240rpx;
  flex-shrink: 0;
  padding: 28rpx 0;
  font-size: 28rpx;
}

.notes-btn-save {
  flex: 1;
  padding: 28rpx 0;
  font-size: 28rpx;
}
