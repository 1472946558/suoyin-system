@import "../../styles/customer.wxss";

/* pkg-customer/product-detail/index.wxss - 款式详情页 */

.detail-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 主图 */
.d-hero {
  width: 100%;
  height: 624rpx;
  background: #f0f0f0;
}

.d-hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 信息卡 */
.d-info {
  margin: -32rpx 24rpx 0;
  position: relative;
  z-index: 1;
}

.d-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 16rpx;
}

.d-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.d-divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 24rpx -32rpx;
}

.d-price-block {
  display: flex;
  flex-direction: column;
}

.d-price-label {
  font-size: 24rpx;
  color: var(--color-text-sub);
  margin-bottom: 8rpx;
}

.d-price-main {
  display: flex;
  align-items: baseline;
  color: var(--color-danger);
}

.d-price-symbol {
  font-size: 28rpx;
  margin-right: 6rpx;
}

.d-price-value {
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.1;
}

.d-price-unit {
  font-size: 26rpx;
  margin-left: 8rpx;
  color: var(--color-text-sub);
}

.d-price-tip {
  font-size: 22rpx;
  color: var(--color-text-tip);
  margin-top: 8rpx;
}

/* 段落卡 */
.d-section {
  margin: 24rpx;
}

.d-section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 20rpx;
}

.d-section-bar {
  color: var(--color-primary);
  font-size: 36rpx;
  margin-right: 12rpx;
  font-weight: 400;
}

.d-section-body {
  position: relative;
}

.d-section-text {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-sub);
  line-height: 1.8;
}

.d-section-deco {
  position: absolute;
  right: 0;
  bottom: 0;
  font-size: 22rpx;
  color: var(--color-primary-light);
  opacity: 0.5;
}

/* 工费说明 */
.d-fee {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.d-fee-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 16rpx 8rpx;
}

.d-fee-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.d-fee-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-main);
  margin-bottom: 4rpx;
}

.d-fee-sub {
  font-size: 22rpx;
  color: var(--color-text-tip);
}

/* 附近门店 */
.d-stores {
  padding-bottom: 24rpx;
}

.d-stores-head {
  justify-content: flex-start;
}

.d-stores-more {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--color-text-sub);
  font-weight: 400;
}

.d-store-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.d-store-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.d-store-img-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #F4D58D 0%, #BFA15F 60%, #866E23 100%);
  color: #fff;
}

.d-store-img-pic {
  width: 100%;
  height: 100%;
  display: block;
}

.d-store-img-text {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.d-store-info {
  flex: 1;
  min-width: 0;
}

.d-store-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-main);
  margin-bottom: 8rpx;
}

.d-store-addr {
  font-size: 24rpx;
  color: var(--color-text-sub);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.d-store-arrow {
  font-size: 36rpx;
  color: var(--color-text-tip);
  margin-left: 12rpx;
}

.d-store-empty {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-tip);
  padding: 24rpx 0 8rpx;
}

/* 底部空间 + CTA */
.d-bottom-spacer {
  height: 20rpx;
}

.d-cta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #fff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  z-index: 100;
  gap: 20rpx;
}

.d-cta-btn {
  flex: 1;
  font-size: 28rpx;
}

.d-cta-disclaimer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  text-align: center;
  font-size: 22rpx;
  color: #b0b0b0;
  padding: 6rpx 0 calc(6rpx + env(safe-area-inset-bottom));
  background: #fff;
  z-index: 99;
}

/* 失败重试 */
.retry-btn {
  width: 240rpx;
  margin: 24rpx auto 0;
  padding: 16rpx 0;
  font-size: 26rpx;
}
