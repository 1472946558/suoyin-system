@import "../../styles/customer.wxss";

/* pkg-customer/recycle-info/index.wxss - 黄金回收服务介绍页 */

.recycle-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 顶部 Banner */
.ri-hero {
  position: relative;
  background: linear-gradient(135deg, #866E23 0%, #BFA15F 100%);
  padding: 80rpx 40rpx 60rpx;
  color: #fff;
  text-align: center;
  overflow: hidden;
}

.ri-hero-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.35;
}

.ri-hero > view:not(.ri-hero-img) {
  position: relative;
  z-index: 1;
}

.ri-hero-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.ri-hero-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.ri-hero-sub {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.9;
}

/* 通用 section */
.ri-section {
  margin: 24rpx 32rpx;
}

.ri-section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: var(--color-text-main);
}

/* 服务类型 */
.ri-services {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.ri-service-item {
  width: calc(50% - 10rpx);
  background: var(--color-primary-bg);
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  text-align: center;
}

.ri-service-icon {
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.ri-service-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.ri-service-desc {
  font-size: 22rpx;
  color: var(--color-text-sub);
  margin-top: 8rpx;
  line-height: 1.4;
}

/* 回收流程 */
.ri-process {
  display: flex;
  flex-direction: column;
}

.ri-step {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  position: relative;
}

.ri-step-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ri-step-body {
  margin-left: 20rpx;
  flex: 1;
}

.ri-step-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.ri-step-desc {
  font-size: 24rpx;
  color: var(--color-text-sub);
  margin-top: 6rpx;
}

.ri-step-arrow {
  font-size: 36rpx;
  color: var(--color-text-tip);
  margin-left: 8rpx;
}

/* 注意事项 */
.ri-notice {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.ri-notice-dot {
  color: var(--color-primary);
  font-size: 32rpx;
  margin-right: 12rpx;
  line-height: 1;
  flex-shrink: 0;
}

.ri-notice-text {
  font-size: 26rpx;
  color: var(--color-text-sub);
  line-height: 1.6;
}

/* CTA */
.ri-cta-wrap {
  padding: 40rpx 32rpx;
  text-align: center;
}

.ri-cta-btn {
  padding: 28rpx 0;
}

.ri-cta-tip {
  font-size: 24rpx;
  color: var(--color-text-tip);
  margin-top: 16rpx;
}

.ri-cta-disclaimer {
  font-size: 22rpx;
  color: #b0b0b0;
  margin-top: 10rpx;
}
