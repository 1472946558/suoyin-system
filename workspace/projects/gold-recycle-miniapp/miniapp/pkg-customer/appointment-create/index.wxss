@import "../../styles/customer.wxss";

/* pkg-customer/appointment-create/index.wxss - 到店预约创建页 */

.ac-page {
  min-height: 100vh;
  padding: 24rpx 0 180rpx;
}

.ac-loading {
  padding: 200rpx 0;
  text-align: center;
  color: var(--color-text-tip);
  font-size: 28rpx;
}

/* 通用 section */
.ac-section {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 24rpx;
}

.ac-sec-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.ac-sec-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ac-sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.ac-sec-hint {
  font-size: 24rpx;
  color: var(--color-text-tip);
  font-weight: 400;
  margin-left: auto;
}

/* 门店卡 */
.ac-store-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: var(--color-primary-bg);
  border-radius: 16rpx;
}

.ac-store-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #F4D58D 0%, #BFA15F 60%, #866E23 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ac-store-img-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
}

.ac-store-img-pic {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.ac-store-info {
  flex: 1;
  min-width: 0;
}

.ac-store-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ac-store-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.ac-store-change {
  font-size: 24rpx;
  color: var(--color-primary);
  flex-shrink: 0;
}

.ac-store-addr {
  font-size: 24rpx;
  color: var(--color-text-sub);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 服务类型 2x2 网格 */
.ac-svc-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.ac-svc-item {
  width: calc(50% - 10rpx);
  padding: 32rpx 24rpx;
  border: 4rpx solid var(--color-border);
  border-radius: 16rpx;
  text-align: center;
  background: #fff;
  transition: all 0.2s;
}

.ac-svc-active {
  border-color: var(--color-primary);
  background: var(--color-primary-bg);
}

.ac-svc-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.ac-svc-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-main);
}

/* 日期横向滚动 */
.ac-date-scroll {
  width: 100%;
  white-space: nowrap;
}

.ac-date-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx;
}

.ac-date-item {
  flex-shrink: 0;
  width: 116rpx;
  padding: 20rpx 0;
  background: #fff;
  border: 4rpx solid var(--color-border);
  border-radius: 16rpx;
  text-align: center;
}

.ac-date-active {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.ac-date-active .ac-date-label {
  color: #fff;
}

.ac-date-active .ac-date-sub {
  color: rgba(255, 255, 255, 0.85);
}

.ac-date-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-main);
}

.ac-date-sub {
  font-size: 22rpx;
  color: var(--color-text-sub);
  margin-top: 6rpx;
}

/* 时段网格 4列 */
.ac-slot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ac-slot-item {
  width: calc(25% - 12rpx);
  padding: 20rpx 0;
  background: #fff;
  border: 4rpx solid var(--color-border);
  border-radius: 12rpx;
  text-align: center;
}

.ac-slot-active {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.ac-slot-active .ac-slot-time {
  color: #fff;
}

.ac-slot-active .ac-slot-status {
  color: rgba(255, 255, 255, 0.85);
}

.ac-slot-disabled {
  background: #F5F5F5;
  border-color: #F0F0F0;
  opacity: 0.6;
}

.ac-slot-time {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-main);
}

.ac-slot-status {
  font-size: 20rpx;
  color: var(--color-text-tip);
  margin-top: 4rpx;
}

.ac-slot-avail {
  color: var(--color-text-tip);
}

.ac-slot-empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--color-text-tip);
  font-size: 26rpx;
}

/* 联系人输入 */
.ac-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
}

.ac-input-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.ac-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-main);
  height: 56rpx;
  line-height: 56rpx;
}

.ac-input-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}

.ac-input-btn-primary {
  background: var(--color-primary);
  color: #fff;
}

.ac-input-btn-primary::after {
  border: none;
}

.ac-input-btn-verified {
  font-size: 24rpx;
  color: var(--color-success);
  flex-shrink: 0;
}

.ac-input-divider {
  height: 1rpx;
  background: var(--color-border);
}

.ac-input-tip {
  font-size: 22rpx;
  color: var(--color-text-tip);
  margin-top: 8rpx;
}

/* 备注 */
.ac-remark-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: var(--color-text-main);
  line-height: 1.6;
  background: #F9F9F9;
  border-radius: 12rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.ac-placeholder {
  color: var(--color-text-tip);
  font-size: 26rpx;
}

.ac-remark-counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-tip);
  margin-top: 8rpx;
}

/* 协议 */
.ac-agreement {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx 24rpx;
}

.ac-agreement-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 4rpx solid var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: transparent;
  flex-shrink: 0;
  transition: all 0.2s;
}

.ac-agreement-checked {
  background: var(--color-primary);
  color: #fff;
}

.ac-agreement-text {
  font-size: 24rpx;
  color: var(--color-text-sub);
}

.ac-agreement-link {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* 底部提交 */
.ac-submit-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(134, 110, 35, 0.08);
  z-index: 100;
}

.ac-submit-btn {
  width: 100%;
}
