@import "../../styles/customer.wxss";

/* pkg-customer/store-detail/index.wxss - 门店详情页 */

.detail-page {
  min-height: 100vh;
  padding-bottom: 180rpx;
}

/* Hero */
.s-hero {
  position: relative;
  background: linear-gradient(135deg, #866E23 0%, #BFA15F 100%);
  padding: 48rpx 40rpx 64rpx;
  color: #fff;
  overflow: hidden;
}

.s-hero-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.25;
  z-index: 0;
  object-fit: cover;
}

.s-hero-bg {
  position: relative;
  z-index: 1;
}

.s-hero::before {
  content: "金匠倌";
  position: absolute;
  right: 24rpx;
  bottom: 16rpx;
  font-size: 140rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: rgba(255, 255, 255, 0.06);
  z-index: 0;
}

.s-hero-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  margin-bottom: 16rpx;
}

.s-hero-name {
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.s-hero-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  opacity: 0.95;
}

.s-hero-dist {
  /* 距离 */
}

.s-hero-status {
  padding: 4rpx 12rpx;
  background: #4CAF50;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #fff;
}

/* 卡片 */
.s-card {
  margin: 24rpx 24rpx 0;
}

.s-info {
  margin-top: -32rpx;
  position: relative;
  z-index: 1;
}

.s-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.s-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.s-row-main {
  flex: 1;
  min-width: 0;
}

.s-label {
  font-size: 22rpx;
  color: var(--color-text-tip);
  margin-bottom: 6rpx;
}

.s-value {
  font-size: 28rpx;
  color: var(--color-text-main);
  line-height: 1.5;
}

.s-phone {
  color: var(--color-primary);
  font-weight: 500;
}

.s-row-action {
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  flex-shrink: 0;
}

.s-row-action-text {
  font-weight: 500;
}

.s-divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 0 -32rpx;
}

/* 时段 */
.s-slots {
  padding-bottom: 24rpx;
}

.s-slots-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.s-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.s-slots-more {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 400;
}

.s-slots-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.slot-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: var(--color-primary-bg);
  border: 2rpx solid var(--color-primary-light);
}

.slot-chip.slot-open {
  background: var(--color-primary-bg);
  border-color: var(--color-primary-light);
}

.slot-chip.slot-disabled {
  background: #F5F5F5;
  border-color: #E0E0E0;
  color: var(--color-text-tip);
}

.slot-time {
  font-size: 28rpx;
  font-weight: 500;
}

.slot-state {
  font-size: 20rpx;
  margin-top: 4rpx;
}

/* 服务 */
.s-service {
  padding-bottom: 24rpx;
}

.s-service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.s-tag {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--color-primary-bg);
  border: 2rpx solid var(--color-primary-light);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--color-primary);
}

.s-tag-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

/* 提示 */
.s-tips {
  display: flex;
  align-items: center;
  background: var(--color-primary-bg);
  border-radius: var(--radius-md);
  margin: 24rpx;
  padding: 16rpx 24rpx;
}

.s-tip-icon {
  font-size: 28rpx;
  color: var(--color-primary);
  margin-right: 12rpx;
}

.s-tip-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-primary);
}

/* 底部空间 + CTA */
.s-bottom-spacer {
  height: 20rpx;
}

.s-cta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -2rpx 12rpx rgba(134, 110, 35, 0.08);
  z-index: 100;
}

.s-btn {
  flex: 1;
  padding: 22rpx 0;
  font-size: 28rpx;
}

/* 重试 */
.retry-btn {
  width: 240rpx;
  margin: 24rpx auto 0;
  padding: 16rpx 0;
  font-size: 26rpx;
}
