# Copy this file to /srv/miniapp/config/.env.production for host-mode deployment.
HOST=127.0.0.1
PORT=3001
APP_MODE=persistent
TOKEN_SECRET=replace_with_strong_random_secret
CORS_ORIGIN=https://example.com
WECHAT_MINIAPP_APP_ID=touristappid
WECHAT_MINIAPP_APP_SECRET=replace_with_wechat_miniapp_secret
WECHAT_API_BASE_URL=https://api.weixin.qq.com
MINIAPP_ALLOW_MOCK_LOGIN=false

# Prefer MYSQL_DSN when secrets are injected by the server.
MYSQL_DSN=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=miniapp_prod
MYSQL_USER=miniapp_app
MYSQL_PASSWORD=replace_with_db_password
MYSQL_CHARSET=utf8mb4

REDIS_ADDR=127.0.0.1:6379
REDIS_USER=
REDIS_PASSWORD=replace_with_redis_password
REDIS_DB=0
REDIS_KEY_PREFIX=miniapp:

# Object storage / CDN base for recycle photo evidence.
STORAGE_ENABLED=false
STORAGE_PROVIDER=replace_with_cos_or_oss
STORAGE_BUCKET=replace_with_bucket
STORAGE_REGION=replace_with_region
STORAGE_ENDPOINT=oss-cn-beijing.aliyuncs.com
STORAGE_PUBLIC_BASE_URL=https://replace-with-cdn-or-bucket-domain/recycle
STORAGE_PATH_PREFIX=recycle-evidence
STORAGE_UPLOAD_STRATEGY=oss_signed_put
STORAGE_ACCESS_KEY_ID=replace_with_oss_access_key_id
STORAGE_ACCESS_KEY_SECRET=replace_with_oss_access_key_secret
STORAGE_UPLOAD_URL_TTL_SECONDS=1800
STORAGE_CALLBACK_ENABLED=false
STORAGE_STATUS_DESCRIPTION=对象存储待正式配置
