# Compose host ports. Recommended to expose only to localhost and proxy with host Nginx.
API_PORT=18082
ADMIN_PORT=14176
MYSQL_EXPOSE_PORT=13306
REDIS_EXPOSE_PORT=16379

# Backend runtime.
# memory: local demo / smoke
# persistent: pre-prod / prod, requires both MySQL and Redis
APP_MODE=memory
HOST=
TOKEN_SECRET=replace_with_strong_random_secret
CORS_ORIGIN=*
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
WECHAT_API_BASE_URL=https://api.weixin.qq.com
MINIAPP_ALLOW_MOCK_LOGIN=true

# MySQL. Prefer MYSQL_DSN when your server injects a full DSN.
MYSQL_DSN=
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=miniapp_prod
MYSQL_USER=miniapp_app
MYSQL_PASSWORD=change_me
MYSQL_CHARSET=utf8mb4
MYSQL_ROOT_PASSWORD=change_root_password

# Redis. REDIS_USER is usually blank unless ACL users are enabled.
REDIS_ADDR=redis:6379
REDIS_USER=
REDIS_PASSWORD=change_me
REDIS_DB=0
REDIS_KEY_PREFIX=miniapp:

# Object storage for recycle photo evidence.
# Set STORAGE_ENABLED=true only after the upload URL/base URL is reachable by the miniapp.
STORAGE_ENABLED=false
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=
STORAGE_PATH_PREFIX=recycle-evidence
STORAGE_UPLOAD_STRATEGY=oss_signed_put
STORAGE_ACCESS_KEY_ID=
STORAGE_ACCESS_KEY_SECRET=
STORAGE_UPLOAD_URL_TTL_SECONDS=1800
STORAGE_CALLBACK_ENABLED=false
STORAGE_STATUS_DESCRIPTION=对象存储待配置，当前不允许 production 模式伪装正式留档
