.detail-hero .hero-title {
  font-size: 55rpx;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.hero-tag,
.hero-copy-btn,
.stats-value,
.stats-label,
.check-title,
.check-desc,
.timeline-label,
.timeline-value {
  display: block;
}

.hero-tag {
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  color: var(--brand-deep);
  font-size: 24.2rpx;
  background: rgba(212, 175, 55, 0.14);
}

.hero-copy-btn {
  width: fit-content;
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border: 0.8rpx solid var(--line);
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 26.4rpx;
  font-weight: 800;
  background: #866e23;
  background-color: #866e23;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.stats-card {
  padding: 24rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 16rpx 36rpx rgba(16, 17, 20, 0.06);
}

.stats-value {
  font-size: 33rpx;
  font-weight: 900;
}

.stats-label {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 24.2rpx;
}

.section-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.block-title {
  display: block;
  font-size: 33rpx;
  font-weight: 900;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 29.7rpx;
  font-weight: 800;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  color: var(--muted);
  font-weight: 600;
}

.price-label {
  display: block;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.price-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  color: var(--muted);
  font-size: 26.4rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 14rpx;
}

.print-reset-row {
  display: flex;
  justify-content: center;
  margin-top: 18rpx;
}

.print-reset-btn {
  width: 320rpx;
  height: 68rpx;
  border: 0.8rpx solid var(--line);
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 26.4rpx;
  font-weight: 900;
  line-height: 68rpx;
  background: #866e23;
  background-color: #866e23;
}

.print-preview-card {
  margin-top: 18rpx;
}

.print-preview-box {
  max-height: 560rpx;
  overflow: auto;
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(134, 110, 35, 0.22);
  border-radius: 14rpx;
  color: #111111;
  font-family: monospace;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: left;
  white-space: pre-wrap;
  background: #fffef8;
}

.print-status {
  display: block;
  margin-top: 16rpx;
  color: var(--brand-deep);
  font-size: 25rpx;
  font-weight: 900;
}

.full-print-btn {
  width: 100%;
  margin-top: 18rpx;
}

.photo-note {
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 25.3rpx;
  line-height: 1.6;
}

.photo-grid,
.check-list,
.timeline,
.goods-list {
  display: grid;
}

.photo-grid {
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.photo-chip {
  display: grid;
  gap: 12rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: #fffef8;
}

.photo-thumb {
  width: 100%;
  height: 180rpx;
  border-radius: 18rpx;
  background: #eef1f7;
}

.photo-name {
  font-size: 27.5rpx;
  font-weight: 700;
}

.check-list {
  gap: 16rpx;
  margin-top: 18rpx;
}

.check-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.check-item:last-child {
  border-bottom: 0;
}

.check-dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #d1d7e1;
}

.check-dot.ok {
  background: var(--green);
}

.check-dot.warn {
  background: var(--brand-strong);
}

.check-dot.pending {
  background: #8d95a3;
}

.check-copy {
  display: grid;
  gap: 8rpx;
}

.check-title {
  font-size: 29.7rpx;
  font-weight: 800;
}

.check-desc {
  color: var(--muted);
  font-size: 25.3rpx;
  line-height: 1.6;
}

.timeline {
  gap: 14rpx;
  margin-top: 18rpx;
}

.goods-list {
  gap: 14rpx;
  margin-top: 18rpx;
}

.goods-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #fffef8;
}

.goods-name,
.goods-meta,
.goods-amount {
  display: block;
}

.goods-name {
  font-size: 29.7rpx;
  font-weight: 800;
}

.goods-meta {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 25.3rpx;
}

.goods-amount {
  font-size: 29.7rpx;
  font-weight: 900;
}

.timeline-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #fffef8;
}

.timeline-label {
  color: var(--muted);
  font-size: 26.4rpx;
}

.timeline-value {
  font-size: 27.5rpx;
  font-weight: 800;
  text-align: right;
}
