.detail-hero .hero-title {
  font-size: 50rpx;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.hero-tag,
.hero-copy-btn,
.stats-value,
.stats-label,
.check-title,
.check-desc,
.timeline-label,
.timeline-value {
  display: block;
}

.hero-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.08);
}

.hero-copy-btn {
  width: fit-content;
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.08);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.stats-card {
  padding: 24rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 16rpx 36rpx rgba(16, 17, 20, 0.06);
}

.stats-value {
  font-size: 30rpx;
  font-weight: 900;
}

.stats-label {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.section-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.block-title {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 27rpx;
  font-weight: 800;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  color: var(--muted);
  font-weight: 600;
}

.price-label {
  display: block;
  color: rgba(255, 255, 255, 0.52);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.price-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 14rpx;
}

.photo-note {
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.6;
}

.photo-grid,
.check-list,
.timeline {
  display: grid;
}

.photo-grid {
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.photo-chip {
  display: grid;
  gap: 12rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: #fbfcff;
}

.photo-thumb {
  width: 100%;
  height: 180rpx;
  border-radius: 18rpx;
  background: #eef1f7;
}

.photo-name {
  font-size: 25rpx;
  font-weight: 700;
}

.check-list {
  gap: 16rpx;
  margin-top: 18rpx;
}

.check-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.check-item:last-child {
  border-bottom: 0;
}

.check-dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #d1d7e1;
}

.check-dot.ok {
  background: var(--green);
}

.check-dot.warn {
  background: var(--brand-strong);
}

.check-dot.pending {
  background: #8d95a3;
}

.check-copy {
  display: grid;
  gap: 8rpx;
}

.check-title {
  font-size: 27rpx;
  font-weight: 800;
}

.check-desc {
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.6;
}

.timeline {
  gap: 14rpx;
  margin-top: 18rpx;
}

.timeline-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #fbfcff;
}

.timeline-label {
  color: var(--muted);
  font-size: 24rpx;
}

.timeline-value {
  font-size: 25rpx;
  font-weight: 800;
  text-align: right;
}
