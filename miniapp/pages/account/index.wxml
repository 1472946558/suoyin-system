<view class="page account-page">
  <view class="dark-hero account-hero">
    <text class="eyebrow">LOGIN</text>
    <text class="hero-title">门店登录</text>
    <text class="hero-subtitle">现在支持本地 mock 演示，也支持切到真实 API 联调模式来跑门店登录、收银录单和回收确认闭环。</text>
  </view>

  <view class="card form-card">
    <view class="field">
      <view class="field-head"><image class="field-icon" src="/assets/ui/user.png" mode="aspectFit" /><text class="label">操作员姓名</text></view>
      <input class="input" placeholder="请输入操作员姓名" value="{{form.name}}" data-key="name" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-head"><image class="field-icon" src="/assets/ui/phone.png" mode="aspectFit" /><text class="label">手机号</text></view>
      <input class="input" type="number" placeholder="请输入手机号" value="{{form.phone}}" data-key="phone" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-head"><image class="field-icon" src="/assets/ui/enterprise.png" mode="aspectFit" /><text class="label">岗位角色</text></view>
      <picker mode="selector" range="{{roleOptions}}" range-key="label" value="{{roleIndex}}" bindchange="onRoleChange">
        <view class="picker-box">
          <text>{{form.role || '请选择角色'}}</text>
          <text class="muted">选择</text>
        </view>
      </picker>
    </view>
    <view class="field">
      <view class="field-head"><image class="field-icon" src="/assets/ui/document.png" mode="aspectFit" /><text class="label">门店名称</text></view>
      <input class="input" placeholder="请输入门店名称" value="{{form.storeName}}" data-key="storeName" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-head"><image class="field-icon" src="/assets/ui/list.png" mode="aspectFit" /><text class="label">门店编码</text></view>
      <input class="input" placeholder="例如：SZ-HQB-01" value="{{form.storeCode}}" data-key="storeCode" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-head"><image class="field-icon" src="/assets/ui/clock.png" mode="aspectFit" /><text class="label">班次</text></view>
      <input class="input" placeholder="例如：早班 / 晚班" value="{{form.shiftName}}" data-key="shiftName" bindinput="onInput" />
    </view>
  </view>

  <view class="account-actions">
    <button class="primary-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitProfile">{{submitText}}</button>
    <button class="ghost-btn" bindtap="fillDemo">一键填充演示账号</button>
    <button class="ghost-btn" bindtap="fillBossDemo">填充老板账号</button>
    <button class="text-btn" bindtap="logout">清空本地登录信息</button>
  </view>

  <view class="notice">
    <image class="notice-icon" src="/assets/ui/warning.png" mode="aspectFit" />
    <text>真联调阶段这里需要替换成微信登录、门店员工体系、角色权限和门店组织树。</text>
  </view>
</view>
