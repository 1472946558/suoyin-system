.order-head {
  margin-bottom: 26rpx;
}

.order-head .hero-title {
  font-size: 50rpx;
}

.order-mini-flow {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 30rpx;
}

.order-mini-flow view {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.1);
}

.order-mini-flow image {
  width: 34rpx;
  height: 34rpx;
}

.helper {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 22rpx;
  line-height: 1.5;
}

.price-label {
  display: block;
  color: rgba(255, 255, 255, 0.52);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.price-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}

.distance-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 900;
  background: var(--brand);
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.preview-btn {
  margin-top: 16rpx;
}
