.product-detail-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(128rpx + env(safe-area-inset-bottom));
  background: #ffffff;
}

.detail-hero {
  display: flex;
  gap: 22rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: #ffffff;
}

.detail-image-box {
  overflow: hidden;
  display: flex;
  flex: 0 0 176rpx;
  align-items: center;
  justify-content: center;
  width: 176rpx;
  height: 176rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: #fffef8;
}

.detail-image {
  width: 128rpx;
  height: 128rpx;
}

.detail-hero-copy {
  flex: 1;
  min-width: 0;
}

.detail-title,
.detail-code,
.detail-status,
.section-title-text,
.detail-label,
.detail-value,
.info-value,
.detail-note {
  display: block;
}

.detail-title {
  color: var(--ink);
  font-size: 38.5rpx;
  font-weight: 900;
  line-height: 1.2;
}

.detail-code {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 25.3rpx;
  line-height: 1.4;
}

.detail-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  color: var(--brand-deep);
  font-size: 24.2rpx;
  font-weight: 900;
  background: rgba(212, 175, 55, 0.14);
}

.detail-status.active {
  color: var(--accent);
  background: rgba(24, 183, 123, 0.12);
}

.detail-status.disabled {
  color: #596274;
  background: rgba(119, 125, 136, 0.14);
}

.detail-section {
  margin-top: 18rpx;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: #ffffff;
}

.section-title-text {
  color: var(--ink);
  font-size: 31.9rpx;
  font-weight: 900;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.detail-cell {
  min-width: 0;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #fffef8;
  box-shadow: inset 0 0 0 1rpx var(--line);
}

.detail-label {
  color: var(--muted);
  font-size: 24.2rpx;
}

.detail-value {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 29.7rpx;
  font-weight: 900;
  line-height: 1.25;
}

.info-list {
  margin-top: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.info-row:last-child {
  border-bottom: 0;
}

.info-value {
  flex: 1;
  color: var(--ink);
  font-size: 26.4rpx;
  font-weight: 800;
  line-height: 1.4;
  text-align: right;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.detail-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: var(--brand-deep);
  font-size: 23.1rpx;
  font-weight: 800;
  background: rgba(212, 175, 55, 0.14);
}

.detail-note {
  margin-top: 14rpx;
  color: var(--ink);
  font-size: 27.5rpx;
  line-height: 1.6;
}

.detail-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(246, 231, 161, 0.9);
  background: rgba(255, 255, 255, 0.98);
}

.detail-secondary-btn,
.detail-primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  font-size: 26.4rpx;
  font-weight: 900;
  line-height: 1;
}

.detail-secondary-btn {
  min-width: 136rpx;
  color: var(--brand-deep);
  border: 1rpx solid var(--line);
  background: #ffffff;
  background-color: #ffffff;
}

.detail-primary-btn {
  min-width: 188rpx;
  color: #ffffff;
  border: 1rpx solid var(--line);
  background: #866e23;
  background-color: #866e23;
  box-shadow: 0 10rpx 24rpx rgba(134, 110, 35, 0.14);
}

@media (max-width: 360px) {
  .detail-hero {
    flex-direction: column;
  }

  .detail-grid {
    grid-template-columns: 1fr;
  }
}
