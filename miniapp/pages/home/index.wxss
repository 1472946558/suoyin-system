.brand-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.brand-name,
.brand-desc {
  display: block;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.brand-desc {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.brand-chip {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #8a5a00;
  font-size: 22rpx;
  font-weight: 900;
  background: var(--gold-soft);
}

.permission-strip {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.permission-role {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #8a5a00;
  font-size: 22rpx;
  font-weight: 900;
  background: var(--gold-soft);
}

.permission-copy {
  color: var(--muted);
  font-size: 22rpx;
}

.hero-metrics {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 32rpx;
}

.hero-metric {
  padding: 18rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.08);
}

.metric-value,
.metric-label {
  display: block;
}

.metric-value {
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
}

.metric-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 20rpx;
}

.hero-actions {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 34rpx;
}

.hero-action {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  min-width: 0;
  height: 92rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  line-height: 1;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.12), 0 14rpx 28rpx rgba(0, 0, 0, 0.16);
}

.hero-order {
  color: #fff;
  background: rgba(16, 17, 20, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.34);
}

.hero-service {
  color: #fff;
  background: rgba(255, 206, 53, 0.2);
  border: 1rpx solid rgba(255, 206, 53, 0.72);
}

.hero-action-icon-wrap {
  display: grid;
  place-items: center;
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.96);
}

.hero-action-icon {
  width: 34rpx;
  height: 34rpx;
}

.hero-action-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
}

.hero-action-title,
.hero-action-desc {
  display: block;
  text-align: left;
}

.hero-action-title {
  font-size: 24rpx;
  font-weight: 900;
}

.hero-action-desc {
  color: rgba(255, 255, 255, 0.58);
  font-size: 18rpx;
}

.price-board {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(255, 206, 53, 0.18);
}

.price-row:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.price-title,
.price-desc,
.board-price,
.board-trend {
  display: block;
}

.price-title {
  font-size: 28rpx;
  font-weight: 900;
}

.price-desc {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.price-side {
  text-align: right;
}

.board-price {
  font-size: 30rpx;
  font-weight: 900;
}

.board-trend {
  margin-top: 8rpx;
  color: var(--green);
  font-size: 22rpx;
  font-weight: 900;
}

.quick {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  min-width: 0;
  padding: 14rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
}

.quick-icon-wrap {
  display: grid;
  place-items: center;
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: inset 0 0 0 1rpx var(--line);
}

.quick-icon {
  width: 54rpx;
  height: 54rpx;
}

.quick-name {
  font-size: 26rpx;
  font-weight: 900;
}

.quick-desc {
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.resource-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.resource-card {
  min-height: 188rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid rgba(255, 206, 53, 0.18);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(255, 206, 53, 0.18), transparent 120rpx),
    linear-gradient(180deg, #fffdf7 0%, #ffffff 100%);
}

.resource-value,
.resource-label,
.resource-desc {
  display: block;
}

.resource-value {
  font-size: 38rpx;
  font-weight: 900;
}

.resource-label {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.resource-desc {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.5;
}
