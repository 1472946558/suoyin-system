.track-card .hero-title {
  font-size: 52rpx;
}

.rider-card {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
}

.rider-name,
.rider-phone {
  display: block;
}

.rider-name {
  font-size: 30rpx;
  font-weight: 900;
}

.rider-phone {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
}

.call-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 900;
  background: var(--brand);
}

.call-btn image {
  width: 32rpx;
  height: 32rpx;
}

.double-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.compact-field {
  min-width: 0;
}

.price-label {
  display: block;
  color: rgba(255, 255, 255, 0.52);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.settle-line {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 22rpx;
}

.price-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}

.distance-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 900;
  background: var(--brand);
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.photo-rule {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 16rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.photo-status.ok {
  color: var(--green);
}

.photo-status.warn {
  color: var(--brand-deep);
}

.photo-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.photo-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: #fbfcff;
}

.photo-name {
  font-size: 25rpx;
  font-weight: 700;
}

.photo-remove {
  color: var(--red);
  font-size: 24rpx;
  font-weight: 800;
}

.upload-btn {
  margin-top: 14rpx;
}
