.stats-strip,
.form-grid,
.detail-grid,
.record-list,
.purity-list {
  display: grid;
  gap: 16rpx;
}

.stats-strip {
  grid-template-columns: repeat(2, 1fr);
  margin-top: 28rpx;
}

.sub-strip {
  margin-top: 14rpx;
}

.stats-pill {
  padding: 22rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #fffef8;
}

.stats-value,
.stats-label,
.stats-money,
.record-title,
.record-sub,
.detail-item text {
  display: block;
}

.stats-value {
  font-size: 34rpx;
  font-weight: 900;
}

.stats-label,
.stats-money {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.card-head,
.record-head,
.record-foot,
.purity-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.card-title,
.record-title {
  font-size: 32rpx;
  font-weight: 900;
}

.form-grid,
.detail-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.record-card,
.purity-card {
  margin-top: 0;
}

.record-sub,
.record-foot {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 25rpx;
}

.status-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #5f4b16;
  font-size: 23rpx;
  font-weight: 900;
  background: rgba(212, 175, 55, 0.14);
}

.amount-text {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 900;
}

.text-btn {
  min-width: 96rpx;
  height: 54rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 54rpx;
  background: #866e23;
}
