.stats-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.stats-pill {
  padding: 24rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.06);
}

.stats-value,
.stats-label,
.member-name,
.member-phone,
.detail-title,
.status-tag,
.detail-item text {
  display: block;
}

.stats-value {
  font-size: 40rpx;
  font-weight: 900;
}

.stats-label {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.filter-row,
.member-list,
.chip-wall,
.detail-grid {
  display: grid;
  gap: 16rpx;
}

.filter-row {
  grid-template-columns: repeat(2, 1fr);
  margin-top: 18rpx;
}

.compact-picker {
  min-height: 82rpx;
}

.member-card {
  text-align: left;
}

.member-card-active {
  border-color: rgba(255, 206, 53, 0.42);
  box-shadow: 0 18rpx 42rpx rgba(255, 159, 28, 0.12);
}

.member-name {
  font-size: 32rpx;
  font-weight: 900;
}

.member-phone {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.member-meta {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.chip-wall {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 18rpx;
}

.mini-chip {
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  color: var(--brand-deep);
  font-size: 21rpx;
  font-weight: 700;
  text-align: center;
  background: rgba(255, 206, 53, 0.16);
}

.detail-title {
  font-size: 34rpx;
  font-weight: 900;
}

.detail-grid {
  grid-template-columns: repeat(2, 1fr);
  margin-top: 22rpx;
}

.detail-item {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fbfcff;
}

.detail-item text:last-child {
  margin-top: 10rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
}

.status-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.status-tag.active {
  color: #0b7f55;
  background: rgba(24, 183, 123, 0.14);
}

.status-tag.follow_up {
  color: #8a5a00;
  background: rgba(255, 206, 53, 0.2);
}

.status-tag.sleeping {
  color: #596274;
  background: rgba(119, 125, 136, 0.14);
}

.empty-card {
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
}
