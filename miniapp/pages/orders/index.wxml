<view class="page">
  <view class="section-title first-title">
    <view>
      <view class="title-with-icon"><image src="/assets/ui/list.png" mode="aspectFit" /><text>业务订单</text></view>
      <text class="section-kicker">同时查看收银单与回收单状态、金额和留痕情况</text>
    </view>
    <text class="muted small">{{filteredOrders.length}} 单</text>
  </view>

  <scroll-view class="filter-bar" scroll-x enable-flex>
    <view
      class="filter-chip {{bizFilter === item.key ? 'active' : ''}}"
      wx:for="{{bizFilters}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="changeBizFilter"
    >
      {{item.label}}
    </view>
  </scroll-view>

  <scroll-view class="filter-bar" scroll-x enable-flex>
    <view
      class="filter-chip {{filter === item.key ? 'active' : ''}}"
      wx:for="{{filters}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="changeFilter"
    >
      {{item.label}}
    </view>
  </scroll-view>

  <view class="card subtle-card search-card">
    <view class="field">
      <text class="label">搜索订单</text>
      <input class="input" placeholder="单号 / 客户 / 手机号 / 品名 / 门店" value="{{keyword}}" bindinput="onKeywordInput" />
    </view>
    <view class="summary-grid">
      <view class="summary-box">
        <text class="summary-value">{{summary.count}}</text>
        <text class="summary-label">当前订单</text>
      </view>
      <view class="summary-box">
        <text class="summary-value">{{summary.pendingCount}}</text>
        <text class="summary-label">待处理</text>
      </view>
      <view class="summary-box">
        <text class="summary-value">¥{{summary.totalAmount}}</text>
        <text class="summary-label">金额合计</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="card empty-card">
    <text class="empty-title">正在加载订单</text>
    <text class="muted">请稍候，系统正在同步收银单与回收单列表。</text>
  </view>

  <view wx:elif="{{errorText}}" class="card empty-card">
    <text class="empty-title">加载失败</text>
    <text class="muted">{{errorText}}</text>
    <button class="primary-btn" bindtap="loadOrders">重新加载</button>
  </view>

  <view wx:elif="{{filteredOrders.length}}">
    <view class="order-card card" wx:for="{{filteredOrders}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-type="{{item.detailType}}">
      <view class="row between">
        <view class="order-id-wrap">
          <image src="/assets/ui/list.png" mode="aspectFit" />
          <view class="order-id-copy">
            <text class="order-type">{{item.badgeText}}</text>
            <text class="order-id">{{item.orderNo || item.id}}</text>
          </view>
        </view>
        <text class="status-pill {{item.status === 'completed' || item.status === 'confirmed' || item.status === 'paid' || item.status === 'refunded' ? 'done' : 'pending'}}">{{item.statusText}}</text>
      </view>
      <view class="route">
        <view class="route-row">
          <image class="route-icon" src="/assets/ui/user.png" mode="aspectFit" />
          <text>{{item.customerName || '未填写客户'}}{{item.customerPhone ? ' · ' + item.customerPhone : ''}}</text>
        </view>
        <view class="route-row">
          <image class="route-icon" src="/assets/ui/document.png" mode="aspectFit" />
          <text>{{item.routeSummary}}</text>
        </view>
      </view>
      <view class="row between meta">
        <view class="meta-left">
          <image src="/assets/ui/weight.png" mode="aspectFit" />
          <text>{{item.metricText}}</text>
        </view>
        <view class="fee-wrap">
          <image src="/assets/ui/price.png" mode="aspectFit" />
          <text class="fee">¥{{item.amountText}}</text>
        </view>
      </view>
      <view class="row between order-footer">
        <text class="muted">{{item.storeName}} · {{item.createdAt}}</text>
        <text class="muted">{{item.footerText}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="card empty-card">
    <text class="empty-title">当前筛选下暂无订单</text>
    <text class="muted">可以先去收银页或回收录单页创建一笔新业务。</text>
    <button class="primary-btn" bindtap="goOrder">去开单</button>
  </view>
</view>
